# URL de login da aplicação orce-me. A landing roda na porta 5174.
NUXT_PUBLIC_APP_URL=http://localhost:5173/login
# Domínio público HTTPS, sem caminho. Necessário para canonical e sitemap.
NUXT_PUBLIC_SITE_URL=
# Ative somente na publicação pública. Previews/desenvolvimento ficam fora do índice.
NUXT_PUBLIC_INDEXABLE=false
