# Production build settings for scripts/deploy.sh (`nuxt generate`). The
# values are baked into the static pages, robots.txt and sitemap.xml.
NUXT_PUBLIC_APP_URL=https://app.orce.me/login
NUXT_PUBLIC_SITE_URL=https://www.orce.me
# Must match LANDING_INDEXABLE in the VPS /srv/orce/.env (it sets the
# X-Robots-Tag header).
NUXT_PUBLIC_INDEXABLE=true
